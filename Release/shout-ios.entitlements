<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Erlaubt der App mehr Arbeitsspeicher — nötig für die lokalen Modelle
	     (Whisper + MLX-LLM) auf dem iPhone. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Geteilter Speicher mit der Tastatur-Erweiterung (diktierter Text). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.thull24.shout</string>
	</array>
</dict>
</plist>
